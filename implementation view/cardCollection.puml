@startuml

' Layout instellingen
top to bottom direction
skinparam classAttributeIconSize 0
skinparam class {
    BackgroundColor White
    BorderColor Black
}
skinparam linetype ortho

' ========================
'       CONTROLLER
' ========================
class MainController {
}

MainController --> ICardCollectionService
MainController --> ITradeService

' ========================
'       SERVICES
' ========================
interface ICardCollectionService {
    + getAllPacks() : List<Pack>
    + getPackById(packId : int) : Pack
    + getAllCards() : List<Card>
    + getCardById(id : int) : Card
    + openPack(packId : int) : List<Card>
}

class CardCollectionService {
    - CardCollectionRepository cardCollectionRepository
    - PackRepository packRepository

    + getAllPacks() : List<Pack>
    + getPackById(packId : int) : Pack
    + getAllCards() : List<Card>
    + getCardById(id : int) : Card
    + openPack(packId : int) : List<Card>
}

CardCollectionService ..|> ICardCollectionService
CardCollectionService --> CardCollectionRepository
CardCollectionService --> PackRepository

interface ITradeService {
    + requestTrade(fromUserId : int, toUserId : int) : TradeRequest
    + acceptTrade(tradeRequestId : int) : TradeResult
    + declineTrade(tradeRequestId : int) : boolean
    + cancelTrade(tradeRequestId : int) : boolean
}

note right of ITradeService::fromUserId
  Kan ook username zijn in plaats van userId, ff kijken wat handiger is
end note

class TradeService {
    + requestTrade(fromUserId : int, toUserId : int) : TradeRequest
    + acceptTrade(tradeRequestId : int) : TradeResult
    + declineTrade(tradeRequestId : int) : boolean
    + cancelTrade(tradeRequestId : int) : boolean
}

TradeService ..|> ITradeService

' ========================
'       REPOSITORIES
' ========================
class CardCollectionRepository {
    + getAllCards() : List<Card>
    + getCardById(id : int) : Card
}

class PackRepository {
    + getAllPacks() : List<Pack>
    + getPackById(packId : int) : Pack
}

' ========================
'       ENTITIES
' ========================
class Card {
    + id : int
    + name : String
    + description : String
    + rarity : String
    + attack : int
    + hp : int
}

class Pack {
    + id : int
    + name : String
    + rarity : String
}

class UserPack {
    + id : int
    + packId : int
    + userId : int
    + obtainedAt : Date
}

class UserCard {
    + id : int
    + userId : int
    + cardId : int
    + obtainedAt : Date
}

class TradeRequest {
    + id : int
    + fromUserId : int
    + toUserId : int
    + fromCardIds : List<int>
    + toCardIds : List<int>
    + status : TradeStatus
}

class TradeResult {
    + success : boolean
    + message : String
    + cards : List<Card>
}

enum TradeStatus {
    Pending
    Accepted
    Declined
    Cancelled
}

UserPack --> Pack
Pack --> "*" Card : contains

@enduml

