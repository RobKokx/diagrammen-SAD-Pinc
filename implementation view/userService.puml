@startuml UserService

package "User Service" {
    class UserService {
        +getUser(id: String, password: String): User
        +register(user: User, password: String): void
        +updateUser(token: String, username?: String, password?: String): void
        +login(username: String, password: String): token
        +getCards(token: String): List<Card>
        +getDecks(token: String): List<Deck>
        +saveCards(token: String, cards: List<Card>): void
        +saveDecks(token: String, decks: List<Deck>): void
    }

    class User {
        -id: int
        -username: String
        -token: String
        -cards: List<Card>
        -decks: List<Deck>
        -wins: int
        -losses: int
        -mmr: int
        +addWin(): void
        +addLoss(): void
        +updateMmr(mmr: int): void
    }

    class Card {
        -id: int
        -name: String
        -healthPoints: int
        -power: int
        -cost: int
        -type: String
        -rarity: String
        +heal(amount: int): int
        +takeDamage(amount: int): int
        +buffPower(amount: int): int
        +debuffPower(amount: int): int
        +increaseCost(amount: int): int
        +decreaseCost(amount: int): int
    }

    class Deck {
        -id: int
        -name: String
        -cards: List<Card>
    }

    UserService --> Card
    UserService --> User
    UserService --> Deck
}

@enduml